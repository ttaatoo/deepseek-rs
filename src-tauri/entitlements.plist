<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The packaged dsh process runs Node/V8. V8 JIT is required for normal
       Node execution under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- V8 on Intel macOS can use executable pages that are not MAP_JIT. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- dsh loads third-party native Node addons, including node-pty, koffi,
       and node-addon-require-builtin, from the bundled runtime. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
