{
  "name": "deepseek-rs",
  "description": "Unofficial macOS wrapper for the @deepseek-ai/dsh web profile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare-bundle": "node scripts/prepare-bundle.mjs",
    "bundle:test": "node --test scripts/prepare-bundle.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && node --check scripts/prepare-bundle.mjs && pnpm run bundle:test",
    "quality": "pnpm run check && pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "esbuild",
      "koffi",
      "node-pty",
      "protobufjs"
    ]
  }
}
